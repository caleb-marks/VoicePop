<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.caleb.popcornhud</string>
  <key>ProgramArguments</key>
  <array>
    <string>__VOICEPOP_ROOT__/bin/PopcornHUD</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>StandardErrorPath</key>
  <string>/tmp/popcornhud.err</string>
  <key>StandardOutPath</key>
  <string>/tmp/popcornhud.out</string>
</dict>
</plist>
